NODE_ENV=development
PORT=4000

# MongoDB
# Use 127.0.0.1 on Windows if localhost resolves to IPv6 (::1) and MongoDB is not listening there
# For Atlas, include database name in URI, e.g.:
# mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/NBDADB?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nbda

# Redis
REDIS_URL=redis://127.0.0.1:6379

# CORS / client
CLIENT_URL=http://localhost:3000

# JWT / auth (when implemented)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
